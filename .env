# ===================== PN AD NETWORK — Telegram AI Support Bot =====================
# Copy this file to ".env" (cp .env.example .env) and fill in YOUR values.
# NEVER share the .env file, never commit it, never paste its contents in chats.

# 1) Telegram bot token from @BotFather  (looks like 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
# BOT_TOKEN=8876015400:AAGWN_Wm0cB8iPu62gJdoGMwZ4X06CP5Xdw

# 2) Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AQ.Ab8RN6KfakL5GTEGIBeTDE1Wl587b89kXg0OgIAhmzMqd_DKbA
# 2b) OPTIONAL: extra keys (comma/space separated). The FREE tier allows only ~20 requests/day
#     per model; when one key is exhausted the bot parks it and rotates to the next key/model.
#     Add more free keys here to keep the bot answering all day. Example:
#     GEMINI_API_KEYS=AQ.Ab8...key2,AQ.Ab8...key3
GEMINI_API_KEYS=AQ.Ab8RN6KfakL5GTEGIBeTDE1Wl587b89kXg0OgIAhmzMqd_DKbA,AQ.Ab8RN6J9Z1uZyuqXfVcqfZNcELw0aHeOLVrrPR_fB0JOj1_veA,AQ.Ab8RN6L-3TFxHSip0fBah6jBOs8AkjYhw9PkrVXzZ7Oa-eoP8Q,AQ.Ab8RN6JljLXCzc7kaNnpS7CGzjilJzRe2-CN1v2mR44Ytpr3PQ

# 3) Gemini model id. Verified against Google's docs on 2026-10-09. Change it here any time — no code change needed.
GEMINI_MODEL=gemini-3.5-flash
# Used automatically if the main model is overloaded / out of quota (leave empty to disable)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# 4) Your numeric Telegram user id (get it from @userinfobot). Several ids: 111111,222222
#    Admins get /reload and error alerts. Optional but recommended.
ADMIN_IDS=6485074282

# ------------------------- optional settings (defaults are fine) -------------------------
KNOWLEDGE_FILE=./pnweb.xlsx
WEBSITE_URL=https://pnadnetwork.dpdns.org                      # your official site (the only URL the bot may print/allow)
BANGLISH_REPLY=bengali            # bengali | banglish  (reply script when the user writes Banglish)
# HISTORY_LIMIT=10                  # messages remembered per user (user+bot)
# HISTORY_TTL_MINUTES=60
# MAX_INPUT_CHARS=1000
# RATE_LIMIT_MAX=6                  # messages per window per user
# RATE_LIMIT_WINDOW_SECONDS=60
DAILY_LIMIT_PER_USER=0          # 0 = unlimited
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_RETRIES=2
# GEMINI_TEMPERATURE=0.3
# GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_LEVEL=high            # optional (Gemini 3 family): minimal | low | medium | high
# RETRIEVAL_TOP_K=6
# ALLOW_GROUPS=false
# DROP_PENDING_UPDATES=true
# STARTUP_SELF_TEST=true
# LOG_LEVEL=info                    # debug | info | warn | error

# ------------------------- screenshots / images -------------------------
# Users can send a screenshot or photo and the bot reads it and helps. On by default.
VISION_ENABLED=true
# MAX_IMAGE_MB=8                    # reject images larger than this (MB)
# MAX_IMAGES_PER_MESSAGE=3          # how many images of one album to read together
